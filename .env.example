# Vistara Environment Configuration
# All external API integrations are optional with automatic client-side demo fallbacks.
# The application runs with 100% functionality even when these keys are empty.

# Optional MapLibre / Mapbox tile service key (falls back to OpenStreetMap free tiles)
VITE_MAP_API_KEY=

# Optional AI / Natural language processing endpoint (falls back to local heuristic parser)
VITE_AI_API_KEY=

# Application Environment Mode
VITE_APP_ENV=production
